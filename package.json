{
  "name": "best-me",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "expo": "^57.0.24",
    "expo-calendar": "~57.0.4",
    "expo-constants": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~2.33.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "4.28.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^57.0.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
